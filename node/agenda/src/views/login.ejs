<%- include('includes/head.ejs'); %>
<%- include('includes/nav.ejs'); %>

<div class="container my-4">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <h1 class="text-center">Criar conta ou Entrar</h1>
            <p class="text-center lead">Faça login ou crie sua conta abaixo</p>

            <%- include('includes/messages.ejs'); %>

            <div class="row mt-4">

                <!-- Cadastro -->
                <div class="col-lg mb-4 mb-lg-0">
                    <h4>Crie sua conta</h4>
                    <p>Se você ainda não tem conta, registre-se abaixo:</p>

                    <form action="/login/register" method="POST" novalidate>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <div class="form-group mb-3">
                            <label class="form-label" for="register-email">Seu e-mail</label>
                            <input 
                                type="email" 
                                id="register-email"
                                name="email" 
                                class="form-control"
                                required
                                autocomplete="email"
                            >
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label" for="register-password">Sua senha</label>
                            <input 
                                type="password" 
                                id="register-password"
                                name="password" 
                                class="form-control"
                                required
                                autocomplete="new-password"
                            >
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Criar minha conta
                        </button>
                    </form>
                </div>

                <!-- Login -->
                <div class="col-lg">
                    <h4>Entrar</h4>
                    <p>Se você já tem conta, faça login abaixo:</p>

                    <form action="/login/login" method="POST" novalidate>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <div class="form-group mb-3">
                            <label class="form-label" for="login-email">Seu e-mail</label>
                            <input 
                                type="email" 
                                id="login-email"
                                name="email" 
                                class="form-control"
                                required
                                autocomplete="email"
                            >
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label" for="login-password">Sua senha</label>
                            <input 
                                type="password" 
                                id="login-password"
                                name="password" 
                                class="form-control"
                                required
                                autocomplete="current-password"
                            >
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Entrar
                        </button>
                    </form>
                </div>

            </div>

        </div>
    </div>

</div>

<%- include('includes/footer.ejs'); %>
